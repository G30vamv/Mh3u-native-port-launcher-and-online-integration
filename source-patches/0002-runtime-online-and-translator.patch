@@ -0,0 +1,1093 @@
+//! Network emulation layer for Cafe OS (nsysnet.rpl, nn_ac, nn_act, nn_fp).
+//! Handles socket redirection and online multiplayer for MH3U native PC port.
+//! Inspired by Matt-Wood-23/mh3u-revival architecture.
+
+use std::collections::BTreeMap;
+use std::io::{ErrorKind, Read, Write};
+use std::net::{Ipv4Addr, SocketAddr, SocketAddrV4, TcpStream, UdpSocket};
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use crate::cafe::SimpleHandler;
+use crate::guest::Guest;
+
+pub static IS_LOGGED_IN: AtomicBool = AtomicBool::new(false);
+pub static PENDING_LOGIN_NET_MGR: AtomicU32 = AtomicU32::new(0);
+
+pub fn tick_login(g: &Guest) {
+    let pending = PENDING_LOGIN_NET_MGR.load(Ordering::SeqCst);
+    if pending != 0 {
+        let state = g.u8(pending + 0x7b85);
+        if state == 2 {
+            // State 2 = waiting for async login callback.
+            // Transition state to 3 (success), allowing the game's state machine
+            // to execute L_030bc088 which completes the login request and unlocks Tanzia online.
+            g.put_u8(pending + 0x7b85, 3);
+            IS_LOGGED_IN.store(true, Ordering::SeqCst);
+            PENDING_LOGIN_NET_MGR.store(0, Ordering::SeqCst);
+            eprintln!("[online] nn_fp:LoginAsync callback completed -> transitioned state to 3 (success) for net_mgr={:#x}", pending);
+        }
+    }
+}
+
+pub enum HostSocket {
+    Tcp(TcpStream),
+    Udp(UdpSocket),
+    UnboundUdp,
+    UnboundTcp,
+}
+
+pub struct NetManager {
+    next_fd: i32,
+    sockets: BTreeMap<i32, HostSocket>,
+    pub last_err: i32,
+    /// Per socket, every (original destination, redirected destination) pair it has sent to.
+    pub nat_mappings: BTreeMap<i32, Vec<(SocketAddrV4, SocketAddrV4)>>,
+}
+
+impl NetManager {
+    pub const fn new() -> Self {
+        Self {
+            next_fd: 3,
+            sockets: BTreeMap::new(),
+            last_err: 0,
+            nat_mappings: BTreeMap::new(),
+        }
+    }
+
+    pub fn alloc_fd(&mut self, sock: HostSocket) -> i32 {
+        let fd = self.next_fd;
+        self.next_fd += 1;
+        self.sockets.insert(fd, sock);
+        fd
+    }
+
+    pub fn close(&mut self, fd: i32) -> i32 {
+        self.nat_mappings.remove(&fd);
+        if self.sockets.remove(&fd).is_some() {
+            0
+        } else {
+            -1
+        }
+    }
+}
+
+pub static NET: Mutex<NetManager> = Mutex::new(NetManager::new());
+
+fn configure_udp(u: &UdpSocket) {
+    let _ = u.set_nonblocking(true);
+    #[cfg(windows)]
+    {
+        use std::os::windows::io::AsRawSocket;
+        const SIO_UDP_CONNRESET: u32 = 0x9800000c;
+        unsafe extern "system" {
+            fn WSAIoctl(
+                s: usize,
+                dwIoControlCode: u32,
+                lpvInBuffer: *const std::ffi::c_void,
+                cbInBuffer: u32,
+                lpvOutBuffer: *mut std::ffi::c_void,
+                cbOutBuffer: u32,
+                lpcbBytesReturned: *mut u32,
+                lpOverlapped: *mut std::ffi::c_void,
+                lpCompletionRoutine: *mut std::ffi::c_void,
+            ) -> i32;
+        }
+        let handle = u.as_raw_socket() as usize;
+        let mut bytes_ret: u32 = 0;
+        let b_new_behavior: u32 = 0;
+        unsafe {
+            WSAIoctl(
+                handle,
+                SIO_UDP_CONNRESET,
+                &b_new_behavior as *const _ as *const _,
+                std::mem::size_of::<u32>() as u32,
+                std::ptr::null_mut(),
+                0,
+                &mut bytes_ret,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+            );
+        }
+    }
+}
+
+fn is_online_enabled() -> bool {
+    std::env::var_os("MH3U_ONLINE_ENABLED")
+        .map(|v| v != "0" && v != "off" && v != "false")
+        .unwrap_or(true)
+}
+
+fn get_online_server() -> String {
+    std::env::var("MH3U_ONLINE_SERVER").unwrap_or_else(|_| "127.0.0.1".into())
+}
+
+/// IP that peers should use to reach this machine (Radmin/VPN/LAN). Falls back to the server IP.
+/// Per-packet P2P gameplay logging is costly (thousands of stderr writes);
+/// only on with `MH3U_NET_TRACE=1`. Server ports (1223/1224/10025) always log.
+fn net_trace(port: u16) -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    matches!(port, 1223 | 1224 | 10025 | 33335)
+        || *ON.get_or_init(|| std::env::var("MH3U_NET_TRACE").map_or(false, |v| v == "1"))
+}
+
+fn get_local_ip() -> Ipv4Addr {
+    std::env::var("MH3U_LOCAL_IP")
+        .ok()
+        .and_then(|s| s.trim().parse::<Ipv4Addr>().ok())
+        .filter(|ip| !ip.is_unspecified())
+        .unwrap_or_else(|| {
+            get_online_server()
+                .parse()
+                .unwrap_or(Ipv4Addr::new(127, 0, 0, 1))
+        })
+}
+
+fn get_online_port() -> u16 {
+    std::env::var("MH3U_ONLINE_PORT")
+        .ok()
+        .and_then(|p| p.parse().ok())
+        .unwrap_or(9876)
+}
+
+fn get_hunter_name() -> String {
+    std::env::var("MH3U_HUNTER_NAME")
+        .or_else(|_| std::env::var("MH3U_SWKBD_TEXT"))
+        .unwrap_or_else(|_| "Hunter".into())
+}
+
+fn get_principal_id() -> u32 {
+    // Salt with the machine name so two friends using the same hunter name get distinct PIDs
+    // (the server keeps one live session per PID and evicts the older one).
+    let name = format!(
+        "{}@{}",
+        get_hunter_name(),
+        std::env::var("COMPUTERNAME").unwrap_or_default()
+    );
+    let hash = name
+        .bytes()
+        .fold(0x4000_1234u32, |acc, b| acc.wrapping_mul(31).wrapping_add(b as u32));
+    (hash & 0x2fff_ffff) | 0x4000_0000
+}
+
+fn read_sockaddr(g: &Guest, addr_ptr: u32) -> Option<SocketAddrV4> {
+    if addr_ptr == 0 {
+        return None;
+    }
+    let port = g.u16(addr_ptr + 2);
+    let ip_val = g.u32(addr_ptr + 4);
+    let ip = Ipv4Addr::from(ip_val);
+    Some(SocketAddrV4::new(ip, port))
+}
+
+fn write_sockaddr(g: &Guest, addr_ptr: u32, addrlen_ptr: u32, sa: SocketAddrV4) {
+    if addr_ptr != 0 {
+        g.write(addr_ptr, &[16, 2]); // sin_len = 16, sin_family = AF_INET (2)
+        g.put_u16(addr_ptr + 2, sa.port());
+        let ip_bytes = sa.ip().octets();
+        g.write(addr_ptr + 4, &ip_bytes);
+        g.fill(addr_ptr + 8, 0, 8);
+    }
+    if addrlen_ptr != 0 {
+        g.put_u32(addrlen_ptr, 16);
+    }
+}
+
+fn send_logged(u: &UdpSocket, buf: &[u8], to: SocketAddrV4, len: usize) -> usize {
+    match u.send_to(buf, SocketAddr::V4(to)) {
+        Ok(n) => n,
+        Err(e) => {
+            eprintln!("[net] sendto {to} failed: {e}");
+            len
+        }
+    }
+}
+
+fn redirect_dest(dest: SocketAddrV4) -> SocketAddrV4 {
+    if !is_online_enabled() {
+        return dest;
+    }
+    let server_ip: Ipv4Addr = get_online_server()
+        .parse()
+        .unwrap_or(Ipv4Addr::new(127, 0, 0, 1));
+    let server_port = get_online_port();
+
+    // 1. Port 1223: Authentication Server (Nintendo hardcoded/DNS) -> route to server_ip
+    if dest.port() == 1223 {
+        return SocketAddrV4::new(server_ip, 1223);
+    }
+
+    // 2. Ports 10025 & 33335: NATCheck / Traversal Server -> route to server_ip:10025
+    if dest.port() == 10025 || dest.port() == 33335 {
+        return SocketAddrV4::new(server_ip, 10025);
+    }
+
+    // 3a. The NEX server runs on this machine (host): its secure port is always reached over
+    //     loopback, whatever address the ticket advertises (our own VPN IP is not reliable for
+    //     local delivery).
+    if dest.port() == 1224 && server_ip.is_loopback() {
+        return SocketAddrV4::new(Ipv4Addr::LOCALHOST, 1224);
+    }
+
+    // 3. Port 1224: Secure Matchmaking Server
+    // If ticket gave loopback and server is loopback, keep loopback!
+    // If ticket gave loopback, but server is remote, route to server_ip:1224!
+    if dest.port() == 1224 {
+        if dest.ip().is_unspecified() || (dest.ip().is_loopback() && !server_ip.is_loopback()) {
+            return SocketAddrV4::new(server_ip, 1224);
+        } else {
+            return dest;
+        }
+    }
+
+    // 4. Custom online port
+    if dest.port() == server_port {
+        return SocketAddrV4::new(server_ip, server_port);
+    }
+
+    // 5. Unspecified (0.0.0.0) or loopback StationURLs published by the host (it reaches the
+    //    server over 127.0.0.1) -> route to server_ip, which is the host's reachable address.
+    if dest.ip().is_unspecified() || (dest.ip().is_loopback() && !server_ip.is_loopback()) {
+        return SocketAddrV4::new(server_ip, dest.port());
+    }
+
+    dest
+}
+
+/// Look up a networking import by name.
+pub fn find(name: &str) -> Option<SimpleHandler> {
+    Some(match name {
+        // --- nn_ac (Network Connection) ---
+        "nn_ac:Initialize__Q2_2nn2acFv" | "nn_ac:Finalize__Q2_2nn2acFv" | "nn_ac:Close__Q2_2nn2acFv" => {
+            |_, _, c| c.r[3] = 0
+        }
+        "nn_ac:IsApplicationConnected__Q2_2nn2acFPb" => |_, g, c| {
+            let online = is_online_enabled();
+            g.fill(c.r[3], if online { 1 } else { 0 }, 1);
+            c.r[3] = 0;
+        },
+        "nn_ac:Connect__Q2_2nn2acFv" => |_, _, c| {
+            c.r[3] = if is_online_enabled() { 0 } else { 0xffff_ffff };
+        },
+        "nn_ac:GetAssignedAddress__Q2_2nn2acFPUl" => |_, g, c| {
+            eprintln!(
+                "[online] local ip {} (MH3U_LOCAL_IP), server {} (MH3U_ONLINE_SERVER)",
+                get_local_ip(),
