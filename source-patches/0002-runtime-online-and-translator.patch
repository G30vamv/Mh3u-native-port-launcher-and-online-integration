+            let len = c.r[5] as usize;
+            let mut net = NET.lock().unwrap();
+            if let Some(sock) = net.sockets.get_mut(&fd) {
+                let mut buf = vec![0u8; len];
+                match sock {
+                    HostSocket::Udp(u) => loop {
+                        match u.recv_from(&mut buf) {
+                            Ok((n, from_addr)) => {
+                                eprintln!("[net] recv(fd={fd}) -> {n} bytes from {from_addr:?}");
+                                net.last_err = 0;
+                                g.write(buf_ptr, &buf[..n]);
+                                c.r[3] = n as u32;
+                                return;
+                            }
+                            Err(ref e) if e.raw_os_error() == Some(10054) => {
+                                continue;
+                            }
+                            Err(ref e) if e.raw_os_error() == Some(10040) => {
+                                eprintln!("[net] recv(fd={fd}) -> {len} bytes (UDP truncated WSAEMSGSIZE)");
+                                net.last_err = 0;
+                                g.write(buf_ptr, &buf[..len]);
+                                c.r[3] = len as u32;
+                                return;
+                            }
+                            Err(ref e) if e.kind() == ErrorKind::WouldBlock => {
+                                net.last_err = 6; // SO_EWOULDBLOCK
+                                c.r[3] = 0xffff_ffff;
+                                return;
+                            }
+                            Err(e) => {
+                                eprintln!("[net] recv(fd={fd}) error: {e:?}");
+                                net.last_err = 6;
+                                c.r[3] = 0xffff_ffff;
+                                return;
+                            }
+                        }
+                    },
+                    HostSocket::Tcp(t) => match t.read(&mut buf) {
+                        Ok(n) => {
+                            eprintln!("[net] recv(fd={fd}) -> {n} bytes (TCP)");
+                            net.last_err = 0;
+                            g.write(buf_ptr, &buf[..n]);
+                            c.r[3] = n as u32;
+                            return;
+                        }
+                        Err(ref e) if e.kind() == ErrorKind::WouldBlock => {
+                            net.last_err = 6; // SO_EWOULDBLOCK
+                            c.r[3] = 0xffff_ffff;
+                            return;
+                        }
+                        Err(e) => {
+                            eprintln!("[net] recv(fd={fd}) error (TCP): {e:?}");
+                            net.last_err = 6;
+                            c.r[3] = 0xffff_ffff;
+                            return;
+                        }
+                    },
+                    _ => {}
+                }
+            }
+            net.last_err = 6;
+            c.r[3] = 0xffff_ffff;
+        },
+        "nsysnet.rpl:recvfrom" => |_, g, c| {
+            let fd = c.r[3] as i32;
+            let buf_ptr = c.r[4];
+            let len = c.r[5] as usize;
+            let src_ptr = c.r[7];
+            let addrlen_ptr = c.r[8];
+            let mut net = NET.lock().unwrap();
+            if let Some(sock) = net.sockets.get_mut(&fd) {
+                let mut buf = vec![0u8; len];
+                if let HostSocket::Udp(u) = sock {
+                    loop {
+                        match u.recv_from(&mut buf) {
+                            Ok((n, from_addr)) => {
+                                if net_trace(from_addr.port()) {
+                                    eprintln!("[net] recvfrom(fd={fd}) -> {n} bytes from {from_addr:?}");
+                                }
+                                net.last_err = 0;
+                                g.write(buf_ptr, &buf[..n]);
+                                if let SocketAddr::V4(mut v4) = from_addr {
+                                    if let Some(m) = net.nat_mappings.get(&fd) {
+                                        if let Some(&(orig_dest, _)) = m.iter().find(|&&(_, rd)| rd == v4) {
+                                            v4 = orig_dest;
+                                        }
+                                    }
+                                    write_sockaddr(g, src_ptr, addrlen_ptr, v4);
+                                }
+                                c.r[3] = n as u32;
+                                return;
+                            }
+                            Err(ref e) if e.raw_os_error() == Some(10054) => {
+                                continue;
+                            }
+                            Err(ref e) if e.raw_os_error() == Some(10040) => {
+                                eprintln!("[net] recvfrom(fd={fd}) -> {len} bytes (WSAEMSGSIZE truncated)");
+                                net.last_err = 0;
+                                g.write(buf_ptr, &buf[..len]);
+                                c.r[3] = len as u32;
+                                return;
+                            }
+                            Err(ref e) if e.kind() == ErrorKind::WouldBlock => {
+                                net.last_err = 6; // SO_EWOULDBLOCK
+                                c.r[3] = 0xffff_ffff;
+                                return;
+                            }
+                            Err(e) => {
+                                eprintln!("[net] recvfrom(fd={fd}) error: {e:?}");
+                                net.last_err = 6;
+                                c.r[3] = 0xffff_ffff;
+                                return;
+                            }
+                        }
+                    }
+                }
+            }
+            net.last_err = 6;
+            c.r[3] = 0xffff_ffff;
+        },
+        "nsysnet.rpl:select" => |_, g, c| {
+            // select(nfds, readfds, writefds, exceptfds, timeout)
+            let nfds = c.r[3] as usize;
+            let readfds = c.r[4];
+            let writefds = c.r[5];
+            let exceptfds = c.r[6];
+            let timeout_ptr = c.r[7];
+
+            let timeout = if timeout_ptr != 0 {
+                let sec = g.u32(timeout_ptr) as u64;
+                let usec = g.u32(timeout_ptr + 4) as u64;
+                Some(std::time::Duration::from_micros(sec * 1_000_000 + usec))
+            } else {
+                None // Block until ready (capped at 2s)
+            };
+
+            let start = std::time::Instant::now();
+            let max_wait = timeout.unwrap_or(std::time::Duration::from_secs(2));
+
+            let num_words = (nfds + 31) / 32;
+            let mut orig_read = Vec::with_capacity(num_words);
+            if readfds != 0 {
+                for i in 0..num_words {
+                    orig_read.push(g.u32(readfds + (i as u32) * 4));
+                }
+            }
+            let mut orig_write = Vec::with_capacity(num_words);
+            if writefds != 0 {
+                for i in 0..num_words {
+                    orig_write.push(g.u32(writefds + (i as u32) * 4));
+                }
+            }
+
+            loop {
+                let mut ready_count = 0u32;
+                let mut read_ready_count = 0u32;
+                let net = NET.lock().unwrap();
+
+                let mut ready_read = vec![0u32; num_words];
+                if readfds != 0 {
+                    for fd in 0..nfds as i32 {
+                        let word_idx = (fd / 32) as usize;
+                        let bit_idx = (fd % 32) as u32;
+                        let is_requested = (orig_read[word_idx] & (1 << bit_idx)) != 0
+                            || (orig_read[word_idx] & (1 << (31 - bit_idx))) != 0;
+                        if is_requested {
+                            let mut has_data = false;
+                            if let Some(sock) = net.sockets.get(&fd) {
+                                match sock {
+                                    HostSocket::Udp(u) => {
+                                        let mut peek_buf = [0u8; 2048];
+                                        loop {
+                                            match u.peek_from(&mut peek_buf) {
+                                                Ok((n, _)) => {
+                                                    has_data = n > 0;
+                                                    break;
+                                                }
+                                                Err(ref e) if e.raw_os_error() == Some(10040) => {
+                                                    // WSAEMSGSIZE: data is waiting in socket buffer!
+                                                    has_data = true;
+                                                    break;
+                                                }
+                                                Err(ref e) if e.raw_os_error() == Some(10054) => {
+                                                    let _ = u.recv_from(&mut peek_buf);
+                                                    continue;
+                                                }
+                                                _ => {
+                                                    has_data = false;
+                                                    break;
+                                                }
+                                            }
+                                        }
+                                    }
+                                    HostSocket::Tcp(t) => {
+                                        let mut peek_buf = [0u8; 1];
+                                        if let Ok(n) = t.peek(&mut peek_buf) {
+                                            has_data = n > 0;
+                                        }
+                                    }
+                                    _ => {}
+                                }
+                            }
+                            if has_data {
+                                ready_read[word_idx] |= (1 << bit_idx) | (1 << (31 - bit_idx));
+                                ready_count += 1;
+                                read_ready_count += 1;
+                            }
+                        }
+                    }
+                }
+
+                let mut ready_write = vec![0u32; num_words];
+                if writefds != 0 {
+                    for fd in 0..nfds as i32 {
+                        let word_idx = (fd / 32) as usize;
+                        let bit_idx = (fd % 32) as u32;
+                        let is_requested = (orig_write[word_idx] & (1 << bit_idx)) != 0
+                            || (orig_write[word_idx] & (1 << (31 - bit_idx))) != 0;
+                        if is_requested {
+                            if net.sockets.contains_key(&fd) {
+                                ready_write[word_idx] |= (1 << bit_idx) | (1 << (31 - bit_idx));
+                                ready_count += 1;
+                            }
+                        }
+                    }
+                }
+
+                let elapsed = start.elapsed();
+                let has_read_request = readfds != 0 && orig_read.iter().any(|&w| w != 0);
+                // If the guest is polling for read data, give up to a 2ms grace window for loopback packets
+                let min_grace = if has_read_request && read_ready_count == 0 {
+                    std::time::Duration::from_millis(2)
+                } else {
+                    std::time::Duration::ZERO
+                };
+                let wait_limit = max_wait.max(min_grace);
+                let should_return = if has_read_request {
+                    read_ready_count > 0 || elapsed >= wait_limit
+                } else {
+                    ready_count > 0 || elapsed >= wait_limit
+                };
+
+                if should_return {
+                    if readfds != 0 {
+                        for i in 0..num_words {
+                            g.put_u32(readfds + (i as u32) * 4, ready_read[i]);
+                        }
+                    }
+                    if writefds != 0 {
+                        for i in 0..num_words {
+                            g.put_u32(writefds + (i as u32) * 4, ready_write[i]);
+                        }
+                    }
+                    if exceptfds != 0 {
+                        for i in 0..num_words {
+                            g.put_u32(exceptfds + (i as u32) * 4, 0);
+                        }
+                    }
+
+                    if has_read_request || ready_count > 0 {
+                        eprintln!(
+                            "[net] select(nfds={nfds}, readfds={readfds:#x}, writefds={writefds:#x}, timeout={timeout:?}) -> ready={ready_count} (read_ready={read_ready_count}, elapsed={elapsed:?})"
+                        );
+                    }
+                    c.r[3] = ready_count;
+                    return;
+                }
+
+                drop(net);
+                std::thread::sleep(std::time::Duration::from_micros(500));
+            }
+        },
+        "nsysnet.rpl:setsockopt" => |_, _, c| {
+            let fd = c.r[3] as i32;
+            let level = c.r[4];
+            let optname = c.r[5];
+            eprintln!("[net] setsockopt(fd={fd}, level={level:#x}, optname={optname:#x}) -> 0");
+            c.r[3] = 0; // Success
+        },
+        "nsysnet.rpl:getsockname" => |_, g, c| {
+            let fd = c.r[3] as i32;
+            let addr_ptr = c.r[4];
+            let addrlen_ptr = c.r[5];
+            let net = NET.lock().unwrap();
+            let mut local_port = 0u16;
+            if let Some(sock) = net.sockets.get(&fd) {
+                match sock {
+                    HostSocket::Udp(u) => {
+                        if let Ok(addr) = u.local_addr() {
+                            local_port = addr.port();
+                        }
+                    }
+                    HostSocket::Tcp(t) => {
+                        if let Ok(addr) = t.local_addr() {
+                            local_port = addr.port();
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            if local_port == 0 {
+                local_port = get_online_port();
+            }
+            let sa = SocketAddrV4::new(get_local_ip(), local_port);
+            eprintln!("[net] getsockname(fd={fd}) -> {sa:?}");
+            write_sockaddr(g, addr_ptr, addrlen_ptr, sa);
+            c.r[3] = 0;
+        },
+        "nsysnet.rpl:shutdown" => |_, _, c| {
+            let fd = c.r[3] as i32;
+            eprintln!("[net] shutdown(fd={fd})");
+            c.r[3] = 0;
+        },
+
+        s if s.starts_with("nsysnet.rpl:NSSL") => |_, _, c| c.r[3] = 0,
+        s if s.starts_with("nlibcurl.rpl:") => |_, _, c| c.r[3] = 0,
+
+        _ => return None,
+    })
+}
