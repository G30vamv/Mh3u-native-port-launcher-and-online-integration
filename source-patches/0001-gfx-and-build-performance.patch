+//! AMD FidelityFX Super Resolution 1.0 (spatial): EASU upscales the picture to the size it is shown at, RCAS sharpens it.
+//!
+//! The shaders are a WGSL port of `ffx_fsr1.h` (v1.20210629) from GPUOpen-Effects/FidelityFX-FSR, kept to the same maths
+//! (32-bit float path, `FsrEasuF` and `FsrRcasF`), which is distributed under this licence:
+//!
+//! Copyright (c) 2021 Advanced Micro Devices, Inc. All rights reserved.
+//! Permission is hereby granted, free of charge, to any person obtaining a copy
+//! of this software and associated documentation files(the "Software"), to deal
+//! in the Software without restriction, including without limitation the rights
+//! to use, copy, modify, merge, publish, distribute, sublicense, and / or sell
+//! copies of the Software, and to permit persons to whom the Software is
+//! furnished to do so, subject to the following conditions :
+//! The above copyright notice and this permission notice shall be included in
+//! all copies or substantial portions of the Software.
+//! THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+//! IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+//! FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.IN NO EVENT SHALL THE
+//! AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+//! LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+//! OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+//! THE SOFTWARE.
+//!
+//! FSR 1 only upscales, so when the picture is already as large as the place it is shown at (an internal scale of 2x or
+//! more on a 1080p window) the first pass is a plain filtered copy and RCAS still sharpens the result.
+
+/// The format of the picture between the two passes: wide enough to hold EASU's output without rounding it.
+const MID_FORMAT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba16Float;
+
+const VERTEX: &str = r#"
+struct Out { @builtin(position) position: vec4<f32>, @location(0) uv: vec2<f32> };
+
+@vertex fn vs(@builtin(vertex_index) i: u32) -> Out {
+    let p = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    var o: Out;
+    o.position = vec4<f32>(p * 2.0 - 1.0, 0.0, 1.0);
+    o.uv = vec2<f32>(p.x, 1.0 - p.y);
+    return o;
+}
+"#;
+
+const EASU: &str = r#"
+struct Params { out_size: vec2<f32>, pad: vec2<f32> };
+@group(0) @binding(0) var picture: texture_2d<f32>;
+@group(0) @binding(1) var picture_sampler: sampler;
+@group(0) @binding(2) var<uniform> params: Params;
+
+fn rcp_lo(a: f32) -> f32 { return bitcast<f32>(0x7ef07ebbu - bitcast<u32>(a)); }
+fn rsq_lo(a: f32) -> f32 { return bitcast<f32>(0x5f347d74u - (bitcast<u32>(a) >> 1u)); }
+
+fn easu_tap(acc: ptr<function, vec3<f32>>, wsum: ptr<function, f32>, off: vec2<f32>, dir: vec2<f32>, len: vec2<f32>,
+            lob: f32, clp: f32, c: vec3<f32>) {
+    var v = vec2<f32>(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x);
+    v = v * len;
+    let d2 = min(v.x * v.x + v.y * v.y, clp);
+    var wb = 2.0 / 5.0 * d2 - 1.0;
+    var wa = lob * d2 - 1.0;
+    wb = wb * wb;
+    wa = wa * wa;
+    wb = 25.0 / 16.0 * wb - (25.0 / 16.0 - 1.0);
+    let w = wb * wa;
+    *acc = *acc + c * w;
+    *wsum = *wsum + w;
+}
+
+fn easu_set(dir: ptr<function, vec2<f32>>, len: ptr<function, f32>, w: f32, la: f32, lb: f32, lc: f32, ld: f32, le: f32) {
+    let dc = ld - lc;
+    let cb = lc - lb;
+    var len_x = rcp_lo(max(abs(dc), abs(cb)));
+    let dir_x = ld - lb;
+    (*dir).x = (*dir).x + dir_x * w;
+    len_x = saturate(abs(dir_x) * len_x);
+    len_x = len_x * len_x;
+    *len = *len + len_x * w;
+    let ec = le - lc;
+    let ca = lc - la;
+    var len_y = rcp_lo(max(abs(ec), abs(ca)));
+    let dir_y = le - la;
+    (*dir).y = (*dir).y + dir_y * w;
+    len_y = saturate(abs(dir_y) * len_y);
+    len_y = len_y * len_y;
+    *len = *len + len_y * w;
+}
+
+@fragment fn fs(in: Out) -> @location(0) vec4<f32> {
+    let ip = floor(in.position.xy);
+    let in_size = vec2<f32>(textureDimensions(picture));
+    let scale = in_size / params.out_size;
+    var pp = ip * scale + (0.5 * scale - 0.5);
+    let fp = floor(pp);
+    pp = pp - fp;
+
+    let rcp = 1.0 / in_size;
+    let p0 = fp * rcp + vec2<f32>(1.0, -1.0) * rcp;
+    let p1 = p0 + vec2<f32>(-1.0, 2.0) * rcp;
+    let p2 = p0 + vec2<f32>(1.0, 2.0) * rcp;
+    let p3 = p0 + vec2<f32>(0.0, 4.0) * rcp;
+
+    // gather order: x = lower left, y = lower right, z = upper right, w = upper left
+    let bczz_r = textureGather(0, picture, picture_sampler, p0);
+    let bczz_g = textureGather(1, picture, picture_sampler, p0);
+    let bczz_b = textureGather(2, picture, picture_sampler, p0);
+    let ijfe_r = textureGather(0, picture, picture_sampler, p1);
+    let ijfe_g = textureGather(1, picture, picture_sampler, p1);
+    let ijfe_b = textureGather(2, picture, picture_sampler, p1);
+    let klhg_r = textureGather(0, picture, picture_sampler, p2);
+    let klhg_g = textureGather(1, picture, picture_sampler, p2);
+    let klhg_b = textureGather(2, picture, picture_sampler, p2);
+    let zzon_r = textureGather(0, picture, picture_sampler, p3);
+    let zzon_g = textureGather(1, picture, picture_sampler, p3);
+    let zzon_b = textureGather(2, picture, picture_sampler, p3);
+
+    // luma times 2
+    let bczz_l = bczz_b * 0.5 + (bczz_r * 0.5 + bczz_g);
+    let ijfe_l = ijfe_b * 0.5 + (ijfe_r * 0.5 + ijfe_g);
+    let klhg_l = klhg_b * 0.5 + (klhg_r * 0.5 + klhg_g);
+    let zzon_l = zzon_b * 0.5 + (zzon_r * 0.5 + zzon_g);
+    let b_l = bczz_l.x;
+    let c_l = bczz_l.y;
+    let i_l = ijfe_l.x;
+    let j_l = ijfe_l.y;
+    let f_l = ijfe_l.z;
+    let e_l = ijfe_l.w;
+    let k_l = klhg_l.x;
+    let l_l = klhg_l.y;
+    let h_l = klhg_l.z;
+    let g_l = klhg_l.w;
+    let o_l = zzon_l.z;
+    let n_l = zzon_l.w;
+
+    var dir = vec2<f32>(0.0);
+    var len = 0.0;
+    easu_set(&dir, &len, (1.0 - pp.x) * (1.0 - pp.y), b_l, e_l, f_l, g_l, j_l);
+    easu_set(&dir, &len, pp.x * (1.0 - pp.y), c_l, f_l, g_l, h_l, k_l);
+    easu_set(&dir, &len, (1.0 - pp.x) * pp.y, f_l, i_l, j_l, k_l, n_l);
+    easu_set(&dir, &len, pp.x * pp.y, g_l, j_l, k_l, l_l, o_l);
+
+    let dir2 = dir * dir;
+    var dir_r = dir2.x + dir2.y;
+    let zro = dir_r < 1.0 / 32768.0;
+    dir_r = rsq_lo(dir_r);
+    if (zro) { dir_r = 1.0; dir.x = 1.0; }
+    dir = dir * dir_r;
+    len = len * 0.5;
+    len = len * len;
+    let stretch = (dir.x * dir.x + dir.y * dir.y) * rcp_lo(max(abs(dir.x), abs(dir.y)));
+    let len2 = vec2<f32>(1.0 + (stretch - 1.0) * len, 1.0 + -0.5 * len);
+    let lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+    let clp = rcp_lo(lob);
+
+    let f_c = vec3<f32>(ijfe_r.z, ijfe_g.z, ijfe_b.z);
+    let g_c = vec3<f32>(klhg_r.w, klhg_g.w, klhg_b.w);
+    let j_c = vec3<f32>(ijfe_r.y, ijfe_g.y, ijfe_b.y);
+    let k_c = vec3<f32>(klhg_r.x, klhg_g.x, klhg_b.x);
+    let min4 = min(min(f_c, min(g_c, j_c)), k_c);
+    let max4 = max(max(f_c, max(g_c, j_c)), k_c);
+
+    var acc = vec3<f32>(0.0);
+    var wsum = 0.0;
+    easu_tap(&acc, &wsum, vec2<f32>(0.0, -1.0) - pp, dir, len2, lob, clp, vec3<f32>(bczz_r.x, bczz_g.x, bczz_b.x)); // b
+    easu_tap(&acc, &wsum, vec2<f32>(1.0, -1.0) - pp, dir, len2, lob, clp, vec3<f32>(bczz_r.y, bczz_g.y, bczz_b.y)); // c
+    easu_tap(&acc, &wsum, vec2<f32>(-1.0, 1.0) - pp, dir, len2, lob, clp, vec3<f32>(ijfe_r.x, ijfe_g.x, ijfe_b.x)); // i
+    easu_tap(&acc, &wsum, vec2<f32>(0.0, 1.0) - pp, dir, len2, lob, clp, vec3<f32>(ijfe_r.y, ijfe_g.y, ijfe_b.y)); // j
+    easu_tap(&acc, &wsum, vec2<f32>(0.0, 0.0) - pp, dir, len2, lob, clp, vec3<f32>(ijfe_r.z, ijfe_g.z, ijfe_b.z)); // f
+    easu_tap(&acc, &wsum, vec2<f32>(-1.0, 0.0) - pp, dir, len2, lob, clp, vec3<f32>(ijfe_r.w, ijfe_g.w, ijfe_b.w)); // e
+    easu_tap(&acc, &wsum, vec2<f32>(1.0, 1.0) - pp, dir, len2, lob, clp, vec3<f32>(klhg_r.x, klhg_g.x, klhg_b.x)); // k
+    easu_tap(&acc, &wsum, vec2<f32>(2.0, 1.0) - pp, dir, len2, lob, clp, vec3<f32>(klhg_r.y, klhg_g.y, klhg_b.y)); // l
+    easu_tap(&acc, &wsum, vec2<f32>(2.0, 0.0) - pp, dir, len2, lob, clp, vec3<f32>(klhg_r.z, klhg_g.z, klhg_b.z)); // h
+    easu_tap(&acc, &wsum, vec2<f32>(1.0, 0.0) - pp, dir, len2, lob, clp, vec3<f32>(klhg_r.w, klhg_g.w, klhg_b.w)); // g
+    easu_tap(&acc, &wsum, vec2<f32>(1.0, 2.0) - pp, dir, len2, lob, clp, vec3<f32>(zzon_r.z, zzon_g.z, zzon_b.z)); // o
+    easu_tap(&acc, &wsum, vec2<f32>(0.0, 2.0) - pp, dir, len2, lob, clp, vec3<f32>(zzon_r.w, zzon_g.w, zzon_b.w)); // n
+
+    let pix = min(max4, max(min4, acc * (1.0 / wsum)));
+    return vec4<f32>(pix, 1.0);
+}
+"#;
+
+/// RCAS; `{sharp}` is 2^-stops (1.0 is the strongest the filter allows, as in `FsrRcasCon`).
+const RCAS: &str = r#"
+@group(0) @binding(0) var picture: texture_2d<f32>;
+
+fn load(p: vec2<i32>) -> vec3<f32> {
+    let last = vec2<i32>(textureDimensions(picture)) - vec2<i32>(1);
+    return textureLoad(picture, clamp(p, vec2<i32>(0), last), 0).rgb;
+}
+
+fn max3(a: f32, b: f32, c: f32) -> f32 { return max(a, max(b, c)); }
+
+@fragment fn fs(in: Out) -> @location(0) vec4<f32> {
+    let sp = vec2<i32>(floor(in.uv * vec2<f32>(textureDimensions(picture))));
+    let b = load(sp + vec2<i32>(0, -1));
+    let d = load(sp + vec2<i32>(-1, 0));
+    let e = load(sp);
+    let f = load(sp + vec2<i32>(1, 0));
+    let h = load(sp + vec2<i32>(0, 1));
+
+    let mn4 = min(min(b, min(d, f)), h);
+    let mx4 = max(max(b, max(d, f)), h);
+    // the denominators are kept off zero: the reference relies on a hardware reciprocal giving infinity there
+    let hit_min = min(mn4, e) / max(4.0 * mx4, vec3<f32>(1e-6));
+    let hit_max = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3<f32>(-1e-6));
+    let lobe_c = max(-hit_min, hit_max);
+    let lobe = max(-(0.25 - 1.0 / 16.0), min(max3(lobe_c.r, lobe_c.g, lobe_c.b), 0.0)) * {sharp};
+    let pix = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);
+    return vec4<f32>(pix, 1.0);
+}
+"#;
+
+struct Mid {
+    width: u32,
+    height: u32,
+    view: wgpu::TextureView,
+    params: wgpu::Buffer,
+    /// RCAS reads the picture EASU made.
+    rcas_group: wgpu::BindGroup,
+}
+
+pub(crate) struct Fsr {
+    easu: wgpu::RenderPipeline,
+    easu_layout: wgpu::BindGroupLayout,
+    /// The first pass when the picture is not smaller than where it goes: a filtered copy (made with the caller's layout).
+    plain: wgpu::RenderPipeline,
+    rcas: wgpu::RenderPipeline,
+    rcas_layout: wgpu::BindGroupLayout,
+    mid: Option<Mid>,
+}
+
+fn pipeline(device: &wgpu::Device, layout: &wgpu::BindGroupLayout, source: String, format: wgpu::TextureFormat) -> wgpu::RenderPipeline {
+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: Some("fsr"),
+        source: wgpu::ShaderSource::Wgsl(source.into()),
+    });
+    let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+        label: None,
+        bind_group_layouts: &[Some(layout)],
+        immediate_size: 0,
+    });
+    device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+        label: Some("fsr"),
+        layout: Some(&pipeline_layout),
+        vertex: wgpu::VertexState {
+            module: &module,
+            entry_point: Some("vs"),
+            compilation_options: Default::default(),
+            buffers: &[],
+        },
+        fragment: Some(wgpu::FragmentState {
+            module: &module,
+            entry_point: Some("fs"),
+            compilation_options: Default::default(),
+            targets: &[Some(format.into())],
+        }),
+        primitive: wgpu::PrimitiveState::default(),
+        depth_stencil: None,
+        multisample: wgpu::MultisampleState::default(),
+        multiview_mask: None,
+        cache: None,
+    })
+}
+
+fn texture_entry(binding: u32, filterable: bool) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Texture {
+            sample_type: wgpu::TextureSampleType::Float { filterable },
+            view_dimension: wgpu::TextureViewDimension::D2,
+            multisampled: false,
+        },
+        count: None,
+    }
+}
+
+/// RCAS's `sharpness` in stops (0 is the strongest, each stop halves it) from the launcher's 0 to 1 amount.
+pub(crate) fn rcas_stops(amount: f32) -> f32 {
+    ((1.0 - amount.clamp(0.0, 1.0)) * 2.0).clamp(0.0, 2.0)
+}
+
+impl Fsr {
+    /// `blit_layout` is the layout of the plain copy (picture and sampler); `copy_source` its shader.
+    pub(crate) fn new(
+        device: &wgpu::Device,
+        surface_format: wgpu::TextureFormat,
+        blit_layout: &wgpu::BindGroupLayout,
+        copy_source: String,
+        sharpness: f32,
+    ) -> Fsr {
+        let easu_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: None,
+            entries: &[
+                texture_entry(0, true),
+                wgpu::BindGroupLayoutEntry {
+                    binding: 1,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    count: None,
+                },
+                wgpu::BindGroupLayoutEntry {
+                    binding: 2,
+                    visibility: wgpu::ShaderStages::FRAGMENT,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: false,
+                        min_binding_size: None,
+                    },
+                    count: None,
+                },
+            ],
+        });
+        let rcas_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: None,
+            entries: &[texture_entry(0, false)],
+        });
+        let sharp = 2f32.powf(-rcas_stops(sharpness));
+        let rcas_source = format!("{VERTEX}{}", RCAS.replace("{sharp}", &format!("{sharp:.6}")));
+        Fsr {
+            easu: pipeline(device, &easu_layout, format!("{VERTEX}{EASU}"), MID_FORMAT),
+            easu_layout,
+            plain: pipeline(device, blit_layout, copy_source, MID_FORMAT),
+            rcas: pipeline(device, &rcas_layout, rcas_source, surface_format),
+            rcas_layout,
+            mid: None,
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    /// Runs the first pass: the picture `tv`, at `width` x `height` (the size it is shown at), into the middle texture.
+    pub(crate) fn first_pass(
+        &mut self,
+        device: &wgpu::Device,
+        queue: &crate::queue::OrderedQueue,
+        enc: &mut wgpu::CommandEncoder,
+        tv: &wgpu::Texture,
+        sampler: &wgpu::Sampler,
+        copy_layout: &wgpu::BindGroupLayout,
+        width: u32,
+        height: u32,
+    ) {
+        let stale = self.mid.as_ref().is_none_or(|m| m.width != width || m.height != height);
+        if stale {
+            let texture = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("fsr"),
+                size: wgpu::Extent3d {
+                    width,
+                    height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: MID_FORMAT,
+                usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING,
+                view_formats: &[],
+            });
+            let view = texture.create_view(&Default::default());
+            let params = device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("fsr"),
+                size: 16,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+            let mut bytes = [0u8; 16];
+            bytes[0..4].copy_from_slice(&(width as f32).to_le_bytes());
+            bytes[4..8].copy_from_slice(&(height as f32).to_le_bytes());
+            queue.write_buffer(&params, 0, &bytes);
+            let rcas_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: None,
+                layout: &self.rcas_layout,
+                entries: &[wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(&view),
+                }],
+            });
+            self.mid = Some(Mid {
+                width,
+                height,
+                view,
+                params,
+                rcas_group,
+            });
+        }
+        let mid = self.mid.as_ref().expect("made above");
+        let tv_view = tv.create_view(&Default::default());
+        // EASU only makes sense where the picture grows
+        let upscaling = tv.width() < width || tv.height() < height;
+        let (pipeline, group) = if upscaling {
+            let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: None,
+                layout: &self.easu_layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: wgpu::BindingResource::TextureView(&tv_view),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: wgpu::BindingResource::Sampler(sampler),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: mid.params.as_entire_binding(),
+                    },
+                ],
+            });
+            (&self.easu, group)
+        } else {
+            let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: None,
+                layout: copy_layout,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: wgpu::BindingResource::TextureView(&tv_view),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: wgpu::BindingResource::Sampler(sampler),
+                    },
+                ],
+            });
+            (&self.plain, group)
+        };
+        let mut pass = enc.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: Some("fsr easu"),
+            color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                view: &mid.view,
+                depth_slice: None,
+                resolve_target: None,
+                ops: wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                    store: wgpu::StoreOp::Store,
+                },
+            })],
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+            multiview_mask: None,
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &group, &[]);
+        pass.draw(0..3, 0..1);
+    }
+
+    /// Draws the sharpened picture into the pass that presents (the viewport is set by the caller). Needs `first_pass` first.
+    pub(crate) fn second_pass(&self, pass: &mut wgpu::RenderPass<'_>) {
+        if let Some(mid) = &self.mid {
+            pass.set_pipeline(&self.rcas);
+            pass.set_bind_group(0, &mid.rcas_group, &[]);
+            pass.draw(0..3, 0..1);
+        }
+    }
+}
