+//! The settings the overlay's "Settings" window changes while the game runs (`overlay.rs`), and the language of the overlay's text.
+//!
+//! The overlay builds a [`Live`], asks for it with [`request`], and the present pass ([`take`], one atomic load a frame when nothing
+//! changed) applies it: the upscaler's pipelines are rebuilt only when the upscaler or its sharpness changed, the surface is configured
+//! again only when the present mode changed, and the internal resolution only moves the scale the colour buffers are made at (they are
+//! made again the next time the game uses them). The values the player chose are kept in a small `key=value` file ([`save`]) that the
+//! launcher reads at its next start, so there is one place that rules: the launcher's own settings.
+
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, Ordering::Relaxed};
+
+/// The language of the overlay's text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Lang {
+    #[default]
+    En,
+    Es,
+}
+
+impl Lang {
+    /// `es` or `en` (anything else, and nothing, is English).
+    pub fn parse(text: Option<&str>) -> Lang {
+        match text.map(|t| t.trim().to_ascii_lowercase()).as_deref() {
+            Some("es" | "es-es" | "es_es" | "spanish" | "español") => Lang::Es,
+            _ => Lang::En,
+        }
+    }
+
+    pub fn code(self) -> &'static str {
+        match self {
+            Lang::En => "en",
+            Lang::Es => "es",
+        }
+    }
+
+    /// The English or the Spanish text.
+    pub fn p(self, en: &'static str, es: &'static str) -> &'static str {
+        match self {
+            Lang::En => en,
+            Lang::Es => es,
+        }
+    }
+
+    pub fn other(self) -> Lang {
+        match self {
+            Lang::En => Lang::Es,
+            Lang::Es => Lang::En,
+        }
+    }
+}
+
+/// How the picture is scaled to the window.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Upscaler {
+    Off,
+    Cas,
+    Fsr,
+}
+
+impl Upscaler {
+    pub fn parse(text: &str) -> Upscaler {
+        match text.trim().to_ascii_lowercase().as_str() {
+            "fsr" => Upscaler::Fsr,
+            "cas" => Upscaler::Cas,
+            _ => Upscaler::Off,
+        }
+    }
+
+    pub fn code(self) -> &'static str {
+        match self {
+            Upscaler::Off => "off",
+            Upscaler::Cas => "cas",
+            Upscaler::Fsr => "fsr",
+        }
+    }
+}
+
+/// When a frame is shown (`MH3U_PRESENT_MODE`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Present {
+    Fifo,
+    FifoRelaxed,
+    Mailbox,
+    Immediate,
+}
+
+impl Present {
+    pub fn parse(text: Option<&str>) -> Present {
+        match text.map(|t| t.trim().to_ascii_lowercase()).as_deref() {
+            Some("mailbox") => Present::Mailbox,
+            Some("immediate" | "off") => Present::Immediate,
+            Some("fifo_relaxed") => Present::FifoRelaxed,
+            _ => Present::Fifo,
+        }
+    }
+
+    pub fn code(self) -> &'static str {
+        match self {
+            Present::Fifo => "fifo",
+            Present::FifoRelaxed => "fifo_relaxed",
+            Present::Mailbox => "mailbox",
+            Present::Immediate => "immediate",
+        }
+    }
+}
+
+/// The most the internal resolution goes to (a multiple of the console's 1280x720).
+pub const MAX_SCALE: u32 = 4;
+
+/// What can be changed while the game runs.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Live {
+    pub upscaler: Upscaler,
+    /// 0 to 1, as the launcher's 20 to 100 %.
+    pub sharpness: f32,
+    pub present: Present,
+    /// The internal resolution: 1 to [`MAX_SCALE`] times 1280x720.
+    pub scale: u32,
+    pub fps_counter: bool,
+    pub lang: Lang,
+    /// How far a gamepad's right stick (the camera) goes, in percent of what the pad reports: 25 to 150.
+    pub right_stick: u32,
+}
+
+/// The right stick's percent from a setting: 25 to 150, else 100.
+pub fn right_stick(setting: Option<&str>) -> u32 {
+    setting
+        .and_then(|value| value.trim().parse::<u32>().ok())
+        .filter(|pct| (25..=150).contains(pct))
+        .unwrap_or(100)
+}
+
+impl Live {
+    /// The settings the launcher (or the shell) gave in the environment.
+    pub fn from_env() -> Live {
+        let var = |name: &str| std::env::var(name).ok();
+        Live {
+            upscaler: Upscaler::parse(&var("MH3U_UPSCALER").unwrap_or_else(|| "fsr".into())),
+            sharpness: var("MH3U_FSR_SHARPNESS")
+                .and_then(|v| v.parse().ok())
+                .unwrap_or(0.75f32)
+                .clamp(0.0, 1.0),
+            present: Present::parse(var("MH3U_PRESENT_MODE").as_deref()),
+            scale: scale(var("MH3U_GFX_RESOLUTION_SCALE").as_deref()),
+            fps_counter: std::env::var_os("MH3U_FPS").is_some(),
+            lang: Lang::parse(var("MH3U_UI_LANG").as_deref()),
+            right_stick: right_stick(var("MH3U_RIGHT_STICK_SENS").as_deref()),
+        }
+    }
+}
+
+/// A resolution scale from a setting: 1 to [`MAX_SCALE`], else 1.
+pub fn scale(setting: Option<&str>) -> u32 {
+    setting
+        .and_then(|value| value.trim().parse::<u32>().ok())
+        .filter(|scale| (1..=MAX_SCALE).contains(scale))
+        .unwrap_or(1)
+}
+
+static PENDING: Mutex<Option<Live>> = Mutex::new(None);
+static DIRTY: AtomicBool = AtomicBool::new(false);
+
+/// Asks the present pass to apply `live`.
+pub fn request(live: Live) {
+    *PENDING.lock().unwrap_or_else(|e| e.into_inner()) = Some(live);
+    DIRTY.store(true, Relaxed);
+}
+
+/// The settings asked for since the last call, if any: one atomic load when there are none.
+pub fn take() -> Option<Live> {
+    if !DIRTY.load(Relaxed) {
+        return None;
+    }
+    DIRTY.store(false, Relaxed);
+    PENDING.lock().unwrap_or_else(|e| e.into_inner()).take()
+}
+
+/// Where the launcher reads the player's choices from: `MH3U_INGAME_SETTINGS`, else `ingame_settings.txt` in `dir`.
+pub fn file(dir: &Path) -> PathBuf {
+    std::env::var_os("MH3U_INGAME_SETTINGS")
+        .filter(|v| !v.is_empty())
+        .map_or_else(|| dir.join("ingame_settings.txt"), PathBuf::from)
+}
+
+/// The settings as the file keeps them: the launcher's own names (`scale`, `upscaler`, `fsr_sharpness` in percent, `present_mode`,
+/// `fps_counter`, `ui_language`).
+pub fn to_text(live: &Live) -> String {
+    format!(
+        "scale={}\nupscaler={}\nfsr_sharpness={}\npresent_mode={}\nfps_counter={}\nui_language={}\nright_stick_sens={}\n",
+        live.scale,
+        live.upscaler.code(),
+        (live.sharpness * 100.0).round() as u32,
+        live.present.code(),
+        u8::from(live.fps_counter),
+        live.lang.code(),
+        live.right_stick
+    )
+}
+
+/// Keeps the settings in `path` (the launcher takes them at its next start).
+pub fn save(path: &Path, live: &Live) {
+    if let Some(parent) = path.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    if let Err(e) = std::fs::write(path, to_text(live)) {
+        eprintln!("[settings] could not save {}: {e}", path.display());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn language_is_english_unless_spanish() {
+        assert_eq!(Lang::parse(Some("es")), Lang::Es);
+        assert_eq!(Lang::parse(Some(" ES ")), Lang::Es);
+        assert_eq!(Lang::parse(Some("fr")), Lang::En);
+        assert_eq!(Lang::parse(None), Lang::En);
+        assert_eq!(Lang::Es.p("Settings", "Ajustes"), "Ajustes");
+        assert_eq!(Lang::En.other(), Lang::Es);
+    }
+
+    #[test]
+    fn the_scale_stays_in_range() {
+        assert_eq!(scale(Some("3")), 3);
+        assert_eq!(scale(Some("0")), 1);
+        assert_eq!(scale(Some("9")), 1);
+        assert_eq!(scale(Some("x")), 1);
+        assert_eq!(scale(None), 1);
+    }
+
+    #[test]
+    fn the_right_stick_stays_in_range() {
+        assert_eq!(right_stick(Some("60")), 60);
+        assert_eq!(right_stick(Some("10")), 100);
+        assert_eq!(right_stick(Some("999")), 100);
+        assert_eq!(right_stick(None), 100);
+    }
+
+    #[test]
+    fn a_request_is_taken_once() {
+        // one test only touches the shared slot
+        assert_eq!(take(), None);
+        let live = Live {
+            upscaler: Upscaler::Cas,
+            sharpness: 0.5,
+            present: Present::Mailbox,
+            scale: 2,
+            fps_counter: true,
+            lang: Lang::Es,
+            right_stick: 100,
+        };
+        request(live);
+        assert_eq!(take(), Some(live));
+        assert_eq!(take(), None);
+    }
+
+    #[test]
+    fn the_file_uses_the_launchers_names() {
+        let live = Live {
+            upscaler: Upscaler::Fsr,
+            sharpness: 0.75,
+            present: Present::Immediate,
+            scale: 3,
+            fps_counter: false,
+            lang: Lang::En,
+            right_stick: 60,
+        };
+        assert_eq!(
+            to_text(&live),
+            "scale=3\nupscaler=fsr\nfsr_sharpness=75\npresent_mode=immediate\nfps_counter=0\nui_language=en\nright_stick_sens=60\n"
+        );
+    }
+}
