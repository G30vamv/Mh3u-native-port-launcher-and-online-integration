+/// The present mode to use: the one asked for if the surface has it, else the nearest it has (Mailbox falls back to Immediate).
+fn choose_present_mode(requested: wgpu::PresentMode, available: Option<&[wgpu::PresentMode]>) -> wgpu::PresentMode {
+    match available {
+        Some(modes) if modes.contains(&requested) => requested,
+        Some(modes) if requested == wgpu::PresentMode::Mailbox && modes.contains(&wgpu::PresentMode::Immediate) => {
+            wgpu::PresentMode::Immediate
+        }
+        Some(_) => wgpu::PresentMode::Fifo,
+        None => requested,
+    }
+}
+
+fn wgpu_present_mode(mode: crate::settings::Present) -> wgpu::PresentMode {
+    match mode {
+        crate::settings::Present::Fifo => wgpu::PresentMode::Fifo,
+        crate::settings::Present::FifoRelaxed => wgpu::PresentMode::FifoRelaxed,
+        crate::settings::Present::Mailbox => wgpu::PresentMode::Mailbox,
+        crate::settings::Present::Immediate => wgpu::PresentMode::Immediate,
+    }
+}
